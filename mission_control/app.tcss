/* Mission Control
   One look everywhere: rounded, titled panels (lazygit / Posting style) on a dark
   background; the focused panel's border and title light up in the accent; compact
   one-line inputs; thin, quiet scrollbars. Colours come from the theme (themes.py). */

Screen {
    background: $background;
}

* {
    scrollbar-size-vertical: 1;
    scrollbar-size-horizontal: 1;
    scrollbar-color: $panel;
    scrollbar-color-hover: $panel-lighten-2;
    scrollbar-color-active: $accent;
    scrollbar-background: $background;
    scrollbar-background-hover: $background;
    scrollbar-background-active: $background;
    scrollbar-corner-color: $background;
}

/* ---------------------------------------------------------------- panels */

.panel, DataTable, Tree, Detail, #active, .tile, #run-list, #preview-md, #preview-text {
    background: $background;
    border: round $panel;
    border-title-color: $text-muted;
    border-title-style: bold;
    border-subtitle-color: $text-muted;
    padding: 0 1;
}

.panel:focus-within, DataTable:focus, Tree:focus, Detail:focus, .tile:focus, #run-list:focus,
#preview-text:focus {
    border: round $accent;
    border-title-color: $accent;
}

/* ---------------------------------------------------------------- header */

RunHeader {
    height: 3;
    padding: 0 2;
    background: $surface;
    border-bottom: hkey $panel;
}

#header-top {
    height: 1;
}

#brand {
    width: auto;
}

#totals {
    width: 1fr;
    text-align: right;
}

#status {
    height: 1;
}

/* ---------------------------------------------------------------- tables and trees */

DataTable > .datatable--header {
    background: $background;
    color: $text-muted;
    text-style: none;
}

DataTable > .datatable--cursor, Tree > .tree--cursor {
    background: $panel;
    text-style: none;
}

DataTable:focus > .datatable--cursor, Tree:focus > .tree--cursor {
    background: $accent 22%;
}

DataTable > .datatable--hover, Tree > .tree--highlight {
    background: $surface;
}

/* ---------------------------------------------------------------- frame: run list + main area */

#frame {
    height: 1fr;
    padding: 0 1;
}

#main {
    width: 1fr;
}

#main > Horizontal {
    height: 1fr;
}

#run-list {
    width: 34;
    height: 1fr;
    background: $surface;
    margin-right: 1;
}

#run-list > .option-list--option-highlighted {
    background: $accent 22%;
}

#run-list:focus > .option-list--option-highlighted {
    background: $accent 35%;
}

/* ---------------------------------------------------------------- footer */

Footer {
    background: $surface;
}

FooterKey {
    background: $surface;
    color: $text-muted;
}

FooterKey .footer-key--key {
    background: $surface;
    color: $accent;
    text-style: bold;
}

/* ---------------------------------------------------------------- home */

#home {
    width: auto;
    height: auto;
    padding: 1 4;
    border: round $panel;
    background: $surface;
}

/* ---------------------------------------------------------------- overview: 2 x 2 */

#overview {
    grid-size: 2 2;
    grid-columns: 3fr 2fr;
    grid-rows: 1fr 1fr;
    grid-gutter: 0 1;
    height: 1fr;
}

#overview > * {
    height: 1fr;
}

/* ---------------------------------------------------------------- live tiles */

#live {
    grid-size: 2;
    grid-gutter: 0 1;
    height: 1fr;
}

.tile {
    height: 1fr;
    border-title-align: left;
    border-title-color: $text;
    overflow: hidden;
}

.tile:focus {
    background: $surface;
}

/* ---------------------------------------------------------------- agents and session */

#filters {
    height: 1;
    padding: 0 2;
    color: $text-muted;
}

#agents {
    height: 1fr;
}

#session-facts {
    height: auto;
    max-height: 10;
    padding: 0 2;
    margin-bottom: 1;
}

#session-timeline, #session-detail {
    width: 1fr;
}

/* ---------------------------------------------------------------- plugins, models, files */

#plugin-side {
    width: 38;
}

#plugins, #plugin-tools, #models {
    height: 1fr;
}

#plugin-calls, #plugin-detail {
    width: 2fr;
}

#models-note {
    padding: 0 2;
    color: $text-muted;
}

#files {
    width: 40;
}

#preview-md, #preview-text {
    width: 1fr;
}

/* ---------------------------------------------------------------- dialogs */

FullText, Confirm, AskText, KeysScreen {
    align: center middle;
    background: $background 70%;
}

#full-text {
    margin: 1 2;
    border: round $accent;
    background: $surface;
}

.dialog {
    width: 72;
    height: auto;
    padding: 1 3;
    background: $surface;
    border: round $accent;
}

.dialog.keys {
    width: 64;
}

.dialog-buttons {
    height: auto;
    margin-top: 1;
}

.dialog-buttons Button {
    margin-right: 2;
}

.dialog Input {
    margin-top: 1;
}

/* ---------------------------------------------------------------- new mission */

#nm-title {
    height: 1;
    padding: 0 2;
    background: $surface;
    margin-bottom: 1;
}

#nm-help {
    margin: 1 2;
    padding: 1 2;
}

#nm-body {
    height: 1fr;
    padding: 0 1;
}

#nm-left {
    width: 5fr;
    margin-right: 1;
}

#nm-right {
    width: 6fr;
}

#nm-workflow-panel {
    height: auto;
}

#nm-workflow {
    width: 1fr;
}

#nm-workflow-about {
    height: auto;
    margin-top: 1;
}

#nm-request {
    height: 9;
}

#nm-options {
    height: 1fr;
}

#nm-mission {
    height: 3fr;
}

#nm-models {
    height: 2fr;
}

.nm-form-label {
    color: $text-muted;
    text-style: bold;
    margin-top: 1;
}

.nm-select {
    width: 1fr;
}

.nm-check {
    background: transparent;
    height: 1;
}

.nm-numbers {
    grid-size: 2;
    grid-rows: 1;
    grid-gutter: 1 3;
    height: auto;
    margin-top: 1;
}

.nm-number-row {
    height: 1;
}

.nm-number-label {
    width: 1fr;
    color: $text;
}

.nm-number {
    width: 12;
}

.nm-model-row {
    height: 1;
    margin-top: 1;
}

.nm-role {
    width: 14;
    color: $text;
    text-style: bold;
}

.nm-model {
    width: 1fr;
    margin-right: 1;
}

.nm-effort {
    width: 14;
}

#nm-actions {
    height: 1;
    margin: 1 2 0 2;
}

#nm-status {
    width: 1fr;
    height: 1;
}

.action {
    margin-left: 2;
    min-width: 16;
}

.action.go {
    background: $success 30%;
    color: $text;
}

.action.go:disabled {
    background: $panel;
    color: $text-disabled;
}
